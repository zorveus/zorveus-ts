{
  "name": "@zorveus/sdk",
  "version": "0.1.9",
  "description": "Official TypeScript/JavaScript SDK for Zorveus AI Gateway and Management API",
  "repository": {
    "type": "git",
    "url": "https://github.com/zorveus/zorveus-ts",
    "directory": "packages/sdk"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./openai": {
      "import": {
        "types": "./dist/adapters/openai.d.ts",
        "default": "./dist/adapters/openai.mjs"
      },
      "require": {
        "types": "./dist/adapters/openai.d.ts",
        "default": "./dist/adapters/openai.js"
      }
    },
    "./vercel": {
      "import": {
        "types": "./dist/adapters/vercel.d.ts",
        "default": "./dist/adapters/vercel.mjs"
      },
      "require": {
        "types": "./dist/adapters/vercel.d.ts",
        "default": "./dist/adapters/vercel.js"
      }
    }
  },
  "peerDependencies": {
    "openai": "^4.0.0",
    "@ai-sdk/openai": "^0.0.0 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.50",
    "openai": "^7.8.0"
  }
}
