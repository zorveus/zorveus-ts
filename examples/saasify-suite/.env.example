# SaaSify AI Workflow Suite (ResumeCraft) - Environment Configuration

# Zorveus App ID (Required: App ID from your Zorveus Dashboard, e.g. app_0897479c...)
VITE_ZORVEUS_APP_ID=""

# Control Plane Service Key (Required for Startup Admin Portal & Credit Grants)
VITE_ZORVEUS_SERVICE_KEY=""

# Zorveus Control Plane Backend URL (Default: http://localhost:8000)
VITE_ZORVEUS_API_URL="http://localhost:8000"

# Zorveus AI Gateway Base URL (Default: http://localhost:4000/v1)
VITE_ZORVEUS_GATEWAY_URL="http://localhost:4000/v1"

# Optional: Pre-provisioned Tier Inference Keys
VITE_ZORVEUS_FREE_KEY=""
VITE_ZORVEUS_PRO_KEY=""
VITE_ZORVEUS_ENTERPRISE_KEY=""
