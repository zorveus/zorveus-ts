# Zorveus Node.js Automation Scripts Environment Variables

# Inference API Key or User Access Token (Required for inference-demo.ts)
ZORVEUS_INFERENCE_KEY="zrv_live_your_inference_key_here"

# Master Service Key (Required for management-demo.ts to issue credit grants)
ZORVEUS_SERVICE_KEY="zrv_svc_your_service_key_here"

# Zorveus Application ID (Required for product user operations)
ZORVEUS_APP_ID="app_your_application_id_here"

# OAuth 2.0 PKCE Client Credentials (Optional/Required for oauth-pkce-demo.ts)
ZORVEUS_CLIENT_ID="zrv_client_your_oauth_client_id_here"
ZORVEUS_CLIENT_SECRET="zrv_secret_your_oauth_client_secret_here"
ZORVEUS_REDIRECT_URI="http://localhost:5173/oauth/callback"

# Control Plane Base URL (Default: https://api.zorveus.com)
ZORVEUS_BASE_URL="https://api.zorveus.com"

# AI Gateway Base URL (Default: https://api.zorveus.com/v1)
ZORVEUS_GATEWAY_URL="https://api.zorveus.com/v1"
