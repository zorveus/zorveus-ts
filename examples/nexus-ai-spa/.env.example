# Nexus AI - Client-Only PKCE Single Page App
# No clientSecret, no backend proxy, no server session needed!

# Zorveus Public Client ID
VITE_ZORVEUS_CLIENT_ID="zrv_client_your_public_client_id_here"

# Zorveus Control Plane Backend URL (Default: http://localhost:8000)
VITE_ZORVEUS_API_URL="http://localhost:8000"

# Zorveus AI Gateway Base URL (Default: http://localhost:4000/v1)
VITE_ZORVEUS_GATEWAY_URL="http://localhost:4000/v1"

# OAuth Callback Redirect URI
VITE_ZORVEUS_REDIRECT_URI="http://localhost:5175/oauth/callback"
