# MindSpire AI Studio - Environment Configuration

# Zorveus OAuth PKCE Client ID (Required for OAuth Connect Wallet flow)
VITE_ZORVEUS_CLIENT_ID=""

# Optional Client Secret (Only for confidential clients)
VITE_ZORVEUS_CLIENT_SECRET=""

# Direct Inference Key (Optional fallback for direct BYOK testing without OAuth)
VITE_ZORVEUS_INFERENCE_KEY=""

# Zorveus Control Plane Backend URL (Default: http://localhost:8000)
VITE_ZORVEUS_API_URL="http://localhost:8000"

# Zorveus AI Gateway Base URL (Default: http://localhost:4000/v1)
VITE_ZORVEUS_GATEWAY_URL="http://localhost:4000/v1"

# OAuth Callback Redirect URI
VITE_ZORVEUS_REDIRECT_URI="http://localhost:5173/oauth/callback"
